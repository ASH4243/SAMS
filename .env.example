# Copy this file to .env in the project root and update the values.
NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/student_attendance
JWT_SECRET=
CLIENT_URL=http://localhost:5173
# Relative paths are resolved from the project root. Use an absolute path if preferred.
UPLOAD_DIR=server/uploads
LOW_ATTENDANCE_THRESHOLD=75
# Optional: comma-separated additional browser origins when the frontend is hosted separately.
CORS_ORIGINS=http://localhost:5173
# Optional integration-test database. Tests can reset this database when explicitly enabled.
TEST_DATABASE_URL=
ALLOW_TEST_DB_RESET=false
# First-production-admin bootstrap only. Set both temporarily, run npm run db:create-admin, then remove.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
